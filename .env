# GB Wind Forecast Decision Support API - Environment Configuration
APP_NAME=GB Wind Forecast Decision Support API
APP_VERSION=1.0.0
DEBUG=False

# Timezone & Trading Decision Defaults
TIMEZONE=Europe/London
DEFAULT_CUTOFF_LOCAL_TIME=09:00

# Elexon Insights Solution (BMRS API v1)
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_SECONDS=30.0
ELEXON_MAX_RETRIES=3

# Target Delivery Scope
DELIVERY_FROM=2026-01-01
DELIVERY_TO=2026-01-31

# CORS Allowed Origins (JSON array format)
CORS_ORIGINS=["*"]
